{
	"name": "backend",
	"version": "0.0.0",
	"type": "commonjs",
	"scripts": {
		"dev": "nodemon --config ./nodemon.json",
		"build": "tsc -p tsconfig.app.json --noEmit",
		"lint": "eslint .",
		"test": "jest"
	},
	"dependencies": {
		"@nestjs/common": "^11.2.8",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.8",
		"@nestjs/platform-express": "^11.2.8",
		"@nestjs/throttler": "^6.7.1",
		"axios": "^1.11.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"helmet": "^8.3.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"ts-node": "^10.9.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@nestjs/testing": "^11.2.8",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.1.0",
		"@types/supertest": "^7.2.1",
		"eslint": "^9.17.0",
		"jest": "^30.5.2",
		"nodemon": "^2.0.22",
		"supertest": "^7.3.1",
		"ts-jest": "^29.4.15",
		"typescript": "~5.6.2",
		"typescript-eslint": "^8.18.2"
	},
	"jest": {
		"moduleFileExtensions": [
			"ts",
			"js",
			"json"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"tsconfig": "<rootDir>/../tsconfig.app.json"
				}
			]
		},
		"testEnvironment": "node"
	}
}
